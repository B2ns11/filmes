# Copie este arquivo para .env.local e preencha os valores.
# O .env.local é ignorado pelo git — suas chaves nunca sobem pro repositório.

# --- Supabase (obrigatório) ---
# Project Settings → Data API → API URL
SUPABASE_URL=
# Project Settings → API Keys → service_role (NÃO a anon/public)
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (obrigatório) ---
# https://aistudio.google.com/app/apikey → Create API key
GEMINI_API_KEY=
# Opcional: modelo usado. Padrão: gemini-2.0-flash
GEMINI_MODEL=

# --- TMDB (opcional: pôster automático dos filmes) ---
# https://www.themoviedb.org → Configurações → API → API Key (v3 auth)
# Sem esta chave o app funciona igual, só não preenche o pôster sozinho.
TMDB_API_KEY=
