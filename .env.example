# Copie este arquivo para .env.local e preencha os valores.
# O .env.local é ignorado pelo git — suas chaves nunca sobem pro repositório.

# --- Supabase (obrigatório) ---
# Project Settings → Data API → API URL
SUPABASE_URL=
# Project Settings → API Keys → service_role (NÃO a anon/public)
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (obrigatório) ---
# https://aistudio.google.com/app/apikey → Create API key
#
# Aceita VÁRIAS chaves separadas por vírgula. Quando uma bate a cota do dia, o
# app passa para a próxima automaticamente:
#   GEMINI_API_KEY=chave1,chave2
# Só adianta se as chaves forem de PROJETOS diferentes do Google Cloud — a cota
# gratuita é por projeto, então duas chaves do mesmo projeto dividem o mesmo
# limite.
GEMINI_API_KEY=
# Opcional: modelo usado. Padrão: gemini-2.0-flash
# Atenção: a cota diária gratuita muda MUITO de um modelo para outro.
# Confira em https://ai.dev/rate-limit antes de trocar.
GEMINI_MODEL=

# --- TMDB (opcional: pôster automático dos filmes) ---
# https://www.themoviedb.org → Configurações → API → API Key (v3 auth)
# Sem esta chave o app funciona igual, só não preenche o pôster sozinho.
TMDB_API_KEY=
